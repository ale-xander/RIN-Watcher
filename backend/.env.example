# Copy to backend/.env and adjust for your environment.

# SQLite database location.
# Local default: backend/rin_watch.db.
# Production (Render): point it at the mounted persistent disk so the API
# server and the fetch script read and write the exact same file.
# RIN_WATCH_DB=/data/rin_watch.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the deployed frontend. Appended to the allowed origins above
# when set (e.g. https://rin-watch.onrender.com).
# FRONTEND_URL=

# Shared secret for POST /api/admin/fetch, sent as "Authorization: Bearer ...".
# Use a long random value in production (e.g. `openssl rand -hex 32`); keep the
# endpoint disabled by leaving this unset if you never call it.
FETCH_SECRET=my-super-secret-string
