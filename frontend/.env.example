# Copy to frontend/.env.local and adjust for your environment.

# Base URL of the FastAPI backend (defaults to http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only base URL the proxy routes (/api/refresh, /api/ops/*) call.
# Never prefix with NEXT_PUBLIC_; it stays on the server.
FETCH_API_URL=http://localhost:8000
